downloaded_images/*

ghconfig.ini
photolab_denoise.ini

# python
__pycache__
build

# source code
venv
.venv
.envrc

# runtime artifacts (logs, caches, scratch)
*.log
SpeciesViewerLog.txt
sv_gui_cache.json
# (the batch->GUI URL handoff files moved out of the source tree entirely —
#  see utils/runtime_files.py, they now live under the per-OS app-data dir)
# Per-machine Working Days registry (utils/days_registry.py), full of absolute
# local picture paths — meaningless on another machine.
/days_*.json
.trash/
xmptest/
sysprint-recreatetrip.txt
qt/sysprint-recreatetrip.txt
tools/lab_out/

# development
.idea
.vscode

# app remains
svconfig.backup.*

# per-machine configuration — carries the SFTP credential, never commit.
# utils/config.py loads sv_config_<machinename>.ini from the repo root, and
# generate_svconfig_ini() rewrites svconfig.ini on every batch run, so both are
# per-machine state rather than source. Anchored to the root on purpose: the
# example copies under data/configs/ stay tracked (with a blank sftppwd).
/svconfig.ini
/sv_config_*.ini
# ...and the copy that lands in speciesviewer/ when a batch step runs with
# that as its working directory (running batch/*.py from there does this).
# Same file, same SFTP credential inside, just a different cwd.
/speciesviewer/svconfig.ini

Species print.txt

# Backups written by one-off/push_animals_css.py --apply (local rollback copies)
speciesviewer/one-off/animals_css_backup_*/

# Exported reference PDFs (Markdown PDF extension)
docs/pdf/

# Generated manual: built from docs/manual/*.md by tools/svr_manual_build.py.
# The Markdown is the source; the HTML is a one-command rebuild, so it is not
# tracked (a 150 KB blob rewritten on every doc edit is pure diff noise).
docs/manual/SpeciesViewer_Manual.html
docs/manual/pdf/
# Vendored mermaid.js (3 MB, MIT) fetched by --vendor-mermaid so the built
# page needs no network. Re-fetchable in one command; not worth tracking.
docs/manual/_assets/
