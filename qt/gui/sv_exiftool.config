# ExifTool config defining a custom XMP namespace for SpeciesViewer.
# Used (via -config) to WRITE XMP-sv:Municipality, since IPTC/photoshop have no
# standard municipality field. Reading the value needs no config (exiftool
# surfaces unknown XMP properties), so the pipeline stays unaffected until it is
# deliberately added to SELECTED_FIELDS.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        sv => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::sv' } },
    },
);
%Image::ExifTool::UserDefined::sv = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-sv', 2 => 'Location' },
    NAMESPACE => { 'sv' => 'http://houtekamer.com/ns/sv/1.0/' },
    WRITABLE  => 'string',
    Municipality => { },
);
1;  # config files must return a true value
